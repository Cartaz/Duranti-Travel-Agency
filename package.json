{
  "name": "dtagency",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:policy": "node scripts/check-repo-policy.mjs",
    "test": "node --test tests/domain/*.test.ts tests/storage/*.test.ts tests/vault/*.test.ts",
    "test:browser": "playwright test --config=playwright.config.cjs",
    "build": "npm run check:policy && npm test && tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "dexie": "^4.2.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "~5.8.3",
    "vite": "^7.1.3",
    "vite-plugin-pwa": "^1.0.3"
  }
}
